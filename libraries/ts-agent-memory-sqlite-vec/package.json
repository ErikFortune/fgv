{
  "name": "@fgv/ts-agent-memory-sqlite-vec",
  "version": "5.1.0-61",
  "description": "Result-integration boundary providing a persistent, sqlite-vec-backed IVectorIndex for @fgv/ts-agent-memory (survives restarts — no re-embed on open)",
  "main": "lib/index.js",
  "types": "dist/ts-agent-memory-sqlite-vec.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "default": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "types": "./dist/ts-agent-memory-sqlite-vec.d.ts"
    }
  },
  "files": [
    "lib",
    "dist",
    "CHANGELOG.json",
    "README.md",
    "CAPABILITIES.md",
    "LICENSE",
    "!lib/test",
    "!dist/test",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "heft build --clean",
    "clean": "heft clean",
    "test": "heft test --clean",
    "test-handles": "jest --runInBand --detectOpenHandles",
    "clean-jest": "jest --clear-cache",
    "update-snapshot": "jest --updateSnapshot",
    "coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "fixlint": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "typescript",
    "sqlite-vec",
    "vector-index",
    "embeddings",
    "agent-memory",
    "result"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ErikFortune/fgv/issues"
  },
  "homepage": "https://github.com/ErikFortune/fgv/tree/main/libraries/ts-agent-memory-sqlite-vec#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErikFortune/fgv.git"
  },
  "sideEffects": false,
  "devDependencies": {
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/ts-utils": "workspace:*",
    "@fgv/ts-agent-memory": "workspace:*",
    "@fgv/ts-utils-jest": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9",
    "@types/better-sqlite3": "^7.6.13",
    "@microsoft/api-extractor": "^7.60.1",
    "@rushstack/eslint-config": "4.7.0",
    "@rushstack/heft": "1.3.0",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "@rushstack/heft-node-rig": "2.11.50",
    "@types/heft-jest": "1.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "~0.5.4",
    "jest": "^30.5.2",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@fgv/ts-utils": "workspace:*",
    "@fgv/ts-agent-memory": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "sqlite-vec": "^0.1.9"
  }
}
