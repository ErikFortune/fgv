{
  "name": "@fgv/ts-res",
  "version": "5.1.0",
  "description": "Multi-dimensional Resource Runtime",
  "main": "lib/index.js",
  "types": "dist/ts-res.d.ts",
  "scripts": {
    "build": "heft build --clean",
    "clean": "heft clean",
    "test": "heft test --clean",
    "test-ts-res": "heft test --clean",
    "build-docs": "typedoc --options ./config/typedoc.json",
    "build-all": "rushx build; rushx build-docs",
    "test-handles": "heft test --detect-open-handles",
    "clean-jest": "heft test --clean",
    "coverage": "heft test --clean --max-workers 1 --detect-open-handles",
    "lint": "eslint src --ext .ts",
    "fixlint": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "resource",
    "internationalization",
    "globalization",
    "i18n"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ErikFortune/fgv/issues"
  },
  "homepage": "https://github.com/ErikFortune/fgv/tree/main/libraries/ts-res#readme",
  "sideEffects": false,
  "devDependencies": {
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/typedoc-compact-theme": "workspace:*",
    "@fgv/ts-utils-jest": "workspace:*",
    "@microsoft/api-documenter": "^7.30.20",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "eslint-plugin-n": "^17.24.0",
    "@rushstack/eslint-config": "4.7.0",
    "@rushstack/heft": "1.3.0",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "@rushstack/heft-node-rig": "2.11.50",
    "@types/heft-jest": "1.0.6",
    "@fgv/ts-extras": "workspace:*",
    "eslint-plugin-tsdoc": "~0.5.4",
    "typedoc": "~0.28.20"
  },
  "dependencies": {
    "@fgv/ts-utils": "workspace:*",
    "@fgv/ts-json-base": "workspace:*",
    "@fgv/ts-bcp47": "workspace:*",
    "@fgv/ts-json": "workspace:*",
    "luxon": "^3.7.2",
    "fflate": "~0.8.3"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "default": {
        "import": "./lib/index.browser.js",
        "require": "./lib/index.browser.js"
      },
      "types": "dist/ts-res.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikFortune/fgv.git"
  }
}
