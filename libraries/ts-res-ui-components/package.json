{
  "name": "@fgv/ts-res-ui-components",
  "version": "5.1.0-61",
  "description": "Reusable React components for ts-res resource visualization and management",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "heft build --clean",
    "build-docs": "typedoc --options ./config/typedoc.json",
    "build-all": "rushx build && rushx build-docs",
    "clean": "heft clean",
    "test": "heft test --clean",
    "lint": "eslint src --ext .ts,.tsx",
    "fixlint": "eslint src --ext .ts,.tsx --fix",
    "coverage": "jest --coverage"
  },
  "sideEffects": false,
  "keywords": [
    "typescript",
    "react",
    "components",
    "ts-res",
    "resource-management",
    "ui"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ErikFortune/fgv/issues"
  },
  "homepage": "https://github.com/ErikFortune/fgv/tree/main/libraries/ts-res-ui-components#readme",
  "dependencies": {
    "@fgv/ts-res": "workspace:*",
    "@fgv/ts-utils": "workspace:*",
    "@fgv/ts-json": "workspace:*",
    "@fgv/ts-json-base": "workspace:*",
    "@heroicons/react": "~2.2.0",
    "tslib": "^2.9.1",
    "json-edit-react": "~1.30.2",
    "@fgv/ts-extras": "workspace:*",
    "@fgv/ts-web-extras": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/typedoc-compact-theme": "workspace:*",
    "@fgv/ts-utils-jest": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "~19.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.5.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/jest-dom": "~6.9.1",
    "react-dom": "~19.3.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "@rushstack/heft": "1.3.0",
    "@rushstack/heft-web-rig": "1.4.34",
    "@rushstack/eslint-config": "4.7.0",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "@microsoft/api-documenter": "^7.30.20",
    "@microsoft/api-extractor": "^7.60.1",
    "@testing-library/dom": "^10.4.2",
    "typedoc": "~0.28.20"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "default": {
        "import": "./lib/index.browser.js",
        "require": "./lib/index.browser.js"
      },
      "types": "lib/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikFortune/fgv.git"
  }
}
