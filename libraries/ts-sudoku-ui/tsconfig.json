{
  "$schema": "https://developer.microsoft.com/json-schemas/core-build/typescript.schema.json",
  "extends": "./node_modules/@rushstack/heft-web-rig/profiles/library/tsconfig-base.json",
  "compilerOptions": {
    // Stated rather than left to TypeScript's silent default, which is what let a
    // broken `exports` condition stay invisible to the compiler. See
    // `.claude/project/esm-emit-design.md` § "Amendment — `moduleResolution` is the missing variable".
    "moduleResolution": "node10",
    "outDir": "lib",
    "rootDir": "src",
    "jsx": "react",
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "module": "ES2020",
    "target": "ES2020"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "lib", "lib-commonjs"]
}
