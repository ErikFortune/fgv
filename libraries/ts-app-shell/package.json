{
  "name": "@fgv/ts-app-shell",
  "version": "5.1.0",
  "description": "Shared React UI primitives for application shells: column cascade, sidebar, toast/log messages, command palette, keybinding registry",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "heft build --clean",
    "clean": "heft clean",
    "test": "heft test --clean",
    "lint": "eslint src --ext .ts,.tsx",
    "fixlint": "eslint src --ext .ts,.tsx --fix",
    "coverage": "jest --coverage"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "typescript",
    "react",
    "components",
    "app-shell",
    "ui"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "dependencies": {
    "@fgv/ts-utils": "workspace:*",
    "@heroicons/react": "~2.2.0",
    "tslib": "^2.9.1",
    "@fgv/ts-extras": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/ts-utils-jest": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.5.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/jest-dom": "~6.9.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "@rushstack/heft": "1.3.0",
    "@rushstack/eslint-config": "4.7.0",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "@testing-library/dom": "^10.4.2",
    "@rushstack/heft-node-rig": "2.11.50"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "default": {
        "import": "./lib/index.browser.js",
        "require": "./lib/index.browser.js"
      },
      "types": "lib/index.d.ts"
    },
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./theme.css": "./lib/styles/theme.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikFortune/fgv.git"
  }
}
