{
  "name": "@fgv/ts-extras",
  "version": "5.1.0",
  "description": "Assorted Typescript Utilities",
  "main": "lib/index.js",
  "types": "dist/ts-extras.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": "./lib/index.js",
        "require": "./lib/index.js"
      },
      "default": {
        "import": "./lib/index.browser.js",
        "require": "./lib/index.browser.js"
      },
      "types": "./dist/ts-extras.d.ts"
    },
    "./crypto": {
      "node": {
        "import": "./lib/packlets/crypto-utils/index.js",
        "require": "./lib/packlets/crypto-utils/index.js"
      },
      "default": {
        "import": "./lib/packlets/crypto-utils/index.browser.js",
        "require": "./lib/packlets/crypto-utils/index.browser.js"
      }
    },
    "./crypto/keystore": {
      "node": {
        "import": "./lib/packlets/crypto-utils/keystore/index.js",
        "require": "./lib/packlets/crypto-utils/keystore/index.js"
      },
      "default": {
        "import": "./lib/packlets/crypto-utils/keystore/index.browser.js",
        "require": "./lib/packlets/crypto-utils/keystore/index.browser.js"
      }
    },
    "./safer-fetch": {
      "node": {
        "import": "./lib/packlets/safer-fetch/index.js",
        "require": "./lib/packlets/safer-fetch/index.js"
      },
      "default": {
        "import": "./lib/packlets/safer-fetch/index.browser.js",
        "require": "./lib/packlets/safer-fetch/index.browser.js"
      }
    },
    "./hash": {
      "node": {
        "import": "./lib/packlets/hash/index.node.js",
        "require": "./lib/packlets/hash/index.node.js"
      },
      "default": {
        "import": "./lib/packlets/hash/index.browser.js",
        "require": "./lib/packlets/hash/index.browser.js"
      }
    }
  },
  "scripts": {
    "build": "heft build --clean",
    "clean": "heft clean",
    "test": "heft test --clean",
    "build-docs": "typedoc --options ./config/typedoc.json",
    "build-all": "rushx build; rushx build-docs",
    "test-handles": "jest --runInBand --detectOpenHandles",
    "clean-jest": "jest --clear-cache",
    "coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "fixlint": "eslint src --ext .ts --fix"
  },
  "sideEffects": false,
  "keywords": [
    "typescript",
    "json"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ErikFortune/fgv/issues"
  },
  "homepage": "https://github.com/ErikFortune/fgv/tree/main/libraries/ts-extras#ts-utils",
  "devDependencies": {
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/typedoc-compact-theme": "workspace:*",
    "@jest/expect-utils": "^30.5.2",
    "@microsoft/api-documenter": "^7.30.20",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/jest": "^30.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "jest": "^30.5.2",
    "jest-extended": "^4.0.2",
    "jest-matcher-utils": "^30.5.2",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "eslint-plugin-n": "^17.24.0",
    "jest-snapshot": "~30.5.2",
    "@rushstack/heft": "1.3.0",
    "@rushstack/heft-node-rig": "2.11.50",
    "@rushstack/eslint-config": "4.7.0",
    "@types/heft-jest": "1.0.6",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "eslint-plugin-tsdoc": "~0.5.4",
    "@fgv/ts-utils-jest": "workspace:*",
    "@fgv/ts-utils": "workspace:*",
    "@types/js-yaml": "~4.0.9",
    "typedoc": "~0.28.20",
    "typedoc-plugin-markdown": "~4.14.1"
  },
  "dependencies": {
    "@types/luxon": "^3.7.6",
    "luxon": "^3.7.2",
    "mustache": "^4.2.0",
    "papaparse": "^5.7.0",
    "fflate": "~0.8.3",
    "@fgv/ts-json-base": "workspace:*",
    "js-yaml": "~4.3.2"
  },
  "peerDependencies": {
    "@fgv/ts-utils": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikFortune/fgv.git"
  }
}
