{
  "name": "@fgv/testbed",
  "version": "1.0.0",
  "description": "Sample browser app + CLI showcasing fgv capabilities across scenarios. Long-lived; grows over time. See .ai/tasks/active/local-ai-exploration/ for the cluster context.",
  "private": true,
  "main": "lib/cli.js",
  "bin": {
    "testbed": "bin/testbed.js"
  },
  "scripts": {
    "build": "heft build --clean",
    "build:web": "webpack --mode production",
    "build:data": "ts-node scripts/build-data.ts",
    "clean": "heft clean && rimraf dist-web",
    "test": "heft test --clean",
    "test-handles": "jest --runInBand --detectOpenHandles",
    "clean-jest": "jest --clear-cache",
    "update-snapshot": "jest --updateSnapshot",
    "coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "fixlint": "eslint src --ext .ts,.tsx --fix",
    "dev": "webpack serve --mode development",
    "cli": "node bin/testbed.js"
  },
  "keywords": [
    "fgv",
    "sample",
    "testbed",
    "react",
    "typescript"
  ],
  "author": "Erik Fortune",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0 <23.0.0 || >=24.15.0 <25.0.0"
  },
  "dependencies": {
    "@fgv/ts-app-shell": "workspace:*",
    "@fgv/ts-extras": "workspace:*",
    "@fgv/ts-json-base": "workspace:*",
    "@fgv/ts-utils": "workspace:*",
    "@fgv/ts-web-extras": "workspace:*",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "@fgv/ts-prompt-assist": "workspace:*",
    "@fgv/ts-extras-transformers": "workspace:*",
    "@fgv/ts-web-extras-transformers": "workspace:*",
    "@fgv/ts-extras-mcp": "workspace:*",
    "@fgv/ts-agent-memory": "workspace:*",
    "@fgv/ts-agent-tasks": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "~7.29.13",
    "@babel/preset-env": "~7.29.7",
    "@babel/preset-react": "~7.29.7",
    "@babel/preset-typescript": "~7.29.7",
    "@fgv/heft-dual-rig": "workspace:*",
    "@fgv/ts-utils-jest": "workspace:*",
    "@rushstack/eslint-config": "4.7.0",
    "@rushstack/heft": "1.3.0",
    "@rushstack/heft-jest-plugin": "2.0.17",
    "@rushstack/heft-node-rig": "2.11.50",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/heft-jest": "1.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "~10.6.2",
    "babel-loader": "~10.1.1",
    "css-loader": "~7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tsdoc": "~0.5.4",
    "html-webpack-plugin": "~5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "~8.5.32",
    "postcss-loader": "~8.2.1",
    "rimraf": "^6.1.4",
    "style-loader": "~4.0.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "webpack": "~5.112.2",
    "webpack-cli": "~6.0.1",
    "webpack-dev-server": "~5.2.7",
    "@fgv/ts-agent-memory-sqlite-vec": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9"
  }
}
